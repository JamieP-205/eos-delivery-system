<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>EosDelivery</AssemblyName>
    <ApplicationHighDpiMode>DpiUnaware</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <!-- The browser version has its own project; keep its files out of the Windows build. -->
    <Compile Remove="browser/**" />
    <None Remove="browser/**" />
    <Content Remove="browser/**" />
    <EmbeddedResource Remove="browser/**" />
  </ItemGroup>
</Project>
